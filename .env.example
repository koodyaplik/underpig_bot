TELEGRAM_BOT_TOKEN=
# Старое имя BOT_TOKEN также поддерживается, но не задавайте оба одновременно.
TELEGRAM_ADMIN_USER_IDS=
TELEGRAM_ALLOWED_USER_IDS=
# Например: socks5://user:password@host:port
TELEGRAM_PROXY=
BOT_DEFAULT_TIMEZONE=Europe/Moscow

VOICE_TRANSCRIPTION_ENABLED=true
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CACHE_DIR=/models
MAX_DURATION=900

AVIATIONSTACK_API_KEY=
AVIATIONSTACK_BASE_URL=https://api.aviationstack.com/v1
AVIATIONSTACK_TIME_MODE=wall_clock
AVIATIONSTACK_MONTHLY_REQUEST_LIMIT=10000
AVIATIONSTACK_REQUEST_RESERVE=500
AVIATIONSTACK_HARD_REQUEST_CAP=10000
AVIATIONSTACK_ALLOW_OVERAGE=false
AVIATIONSTACK_BILLING_CYCLE_DAY=1
AVIATIONSTACK_MAX_CONCURRENCY=5

DATABASE_PATH=/data/flights.db

SCHEDULER_TICK_SECONDS=30
SCHEDULER_BATCH_SIZE=20
FLIGHT_LEASE_SECONDS=120
HTTP_CONNECT_TIMEOUT_SECONDS=10
HTTP_READ_TIMEOUT_SECONDS=20

MAX_ACTIVE_SUBSCRIPTIONS_PER_USER=10
MAX_ACTIVE_TRACKED_FLIGHTS=100
FLIGHT_COMMANDS_PER_USER_PER_MINUTE=3
SEARCH_CACHE_TTL_SECONDS=120

NOTIFICATION_TIME_CHANGE_THRESHOLD_MINUTES=5
ARRIVAL_STALE_GRACE_HOURS=6
DIVERTED_MAX_TRACKING_HOURS=12
MAX_TRACKING_AGE_HOURS=72
POST_LANDING_BAGGAGE_GRACE_MINUTES=30

FINISHED_FLIGHTS_RETENTION_DAYS=90
RAW_FLIGHT_JSON_RETENTION_DAYS=14
API_REQUEST_LOG_RETENTION_DAYS=120
NOTIFICATION_DELIVERY_RETENTION_DAYS=30
PENDING_SELECTION_TTL_MINUTES=15

LOG_LEVEL=INFO
LOG_FORMAT=json
